# ── AI Explanation APIs (optional — app works without them) ──────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── PostgreSQL Database (auto-configured for Docker) ──────────────────────
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=cashshock_user
DB_PASSWORD=cashshock_password
DB_NAME=cashshock_db

# ── Zoho Books OAuth (optional — for live Indian accounting sync) ─────────
# Client ID and Secret are configured through the Connect Business Data UI.
# Redirect URI: http://localhost:3000/api/connect/zoho/callback
# Add this Redirect URI in Zoho API Console → Your App → Redirect URIs

# ── QuickBooks Online OAuth (optional — for live QB sync) ────────────────
# Client ID and Secret are configured through the Connect Business Data UI.
# Redirect URI: http://localhost:3000/api/connect/quickbooks/callback
# Add this Redirect URI in Intuit Developer Dashboard → Your App → Redirect URIs

# ── WhatsApp Cloud API (optional — enables Liquidity Alert & Briefing) ───
# Meta WhatsApp Cloud API credentials. The access token is a secret:
# keep it server-side only (process.env.WHATSAPP_ACCESS_TOKEN). It must
# NEVER be shipped to the browser, logged, stored in the DB, or committed.
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_API_VERSION=v21.0
WHATSAPP_RECIPIENT_PHONE=your_whatsapp_recipient_phone_here
WHATSAPP_ENABLED=false
